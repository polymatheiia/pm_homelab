{
    admin unix//run/caddy/admin.socket
    order sablier before reverse_proxy
}

{% macro site_body(service) %}
    encode gzip zstd

{% if service.backend_port is defined %}
    handle /api/* {
        reverse_proxy 127.0.0.1:{{ service.backend_port }} {
            header_up X-Forwarded-Proto https
        }
    }

    handle /uploads/* {
        reverse_proxy 127.0.0.1:{{ service.backend_port }} {
            header_up X-Forwarded-Proto https
        }
    }

    handle {
{% if service.sablier is defined and service.sablier %}
        sablier http://127.0.0.1:10000 {
            group {{ service.sablier_group | default(service.name) }}
            session_duration {{ service.sablier_session_duration | default('15m') }}
            dynamic {
                display_name {{ service.sablier_display_name | default(service.name) }}
                theme hacker-terminal
            }
        }
{% endif %}
        reverse_proxy 127.0.0.1:{{ service.port }} {
            header_up X-Forwarded-Proto https
        }
    }
{% else %}
{% if service.sablier is defined and service.sablier %}
    sablier http://127.0.0.1:10000 {
        group {{ service.sablier_group | default(service.name) }}
        session_duration {{ service.sablier_session_duration | default('15m') }}
        dynamic {
            display_name {{ service.sablier_display_name | default(service.name) }}
            theme hacker-terminal
        }
    }
{% endif %}
    reverse_proxy 127.0.0.1:{{ service.port }} {
        header_up X-Forwarded-Proto https
{% if service.sse is defined and service.sse %}
        # Disable response buffering: an SSE endpoint (e.g. GLANCEvault's
        # /events) needs each chunk flushed immediately, or push degrades to
        # polling since the client never sees events until the buffer fills.
        flush_interval -1
{% endif %}
    }
{% endif %}

    header {
        -Server
{% if service.security_headers | default(true) %}
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        # "same-origin" not "no-referrer": Firefox nulls out the Origin
        # header (not just Referer) on same-origin form POSTs when the
        # policy is "no-referrer", which fails Django's CSRF Origin check
        # (seen on healthchecks' magic-link login: "Origin checking failed
        # - null does not match any trusted origins"). same-origin still
        # withholds the referrer from other sites.
        Referrer-Policy "same-origin"
{% endif %}
    }
{% endmacro %}

{% for service in services %}
{% if not (service.no_vhost is defined and service.no_vhost) %}
{{ service.name }}.lab {
{% if tailscale_ip %}
    bind {{ tailscale_ip }}
{% endif %}

    tls internal
{{ site_body(service) }}
}
{% if service.public_domain is defined %}

{{ service.public_domain }} {
{% if tailscale_ip %}
    bind {{ tailscale_ip }}
{% endif %}

    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }
{{ site_body(service) }}
}
{% endif %}
{% endif %}
{% endfor %}
