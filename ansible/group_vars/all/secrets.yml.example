# Secrets used by ansible roles (as opposed to per-service secrets, which
# live in each service's own .env — see services/*/.env.example).
#
# Copy this file to secrets.yml (gitignored) and fill in real values.

# Used by the caddy role for DNS-01 ACME challenges on public domains (real
# Let's Encrypt certs for services exposed via Cloudflare Tunnel, e.g.
# splitpro.grabovska.com), so Caddy never needs port 80/443 reachable from
# the public internet directly.
#
# Create at dash.cloudflare.com > My Profile > API Tokens > Create Token >
# "Edit zone DNS" template, scoped to the specific zone(s) you'll issue
# certs for.
cloudflare_api_token: change_me
