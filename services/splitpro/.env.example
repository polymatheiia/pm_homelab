# SplitPro config
# Full reference: https://github.com/oss-apps/split-pro/blob/main/.env.example
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=splitpro
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@splitpro-db:5432/${POSTGRES_DB}

# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me
NEXTAUTH_URL=https://splitpro.lab

DEFAULT_HOMEPAGE=/home
ENABLE_SENDING_INVITES=false
DISABLE_EMAIL_SIGNUP=false

# SplitPro requires at least one auth provider (email magic-link, Google OAuth, or
# a custom OIDC provider). Pick one and fill in the matching block below.

# TODO: manual setup required — needs an SMTP account/relay to send magic-link emails
FROM_EMAIL=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# TODO: manual setup required — needs a Google Cloud OAuth client (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
