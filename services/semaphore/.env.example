# Semaphore UI — Ansible/Terraform automation runner, on-demand via Sablier (host port 9010)
# Uses embedded SQLite (no external DB required) — the lightest supported option.
# Note: BoltDB ("bolt" dialect) was removed by upstream; sqlite is its replacement.

SEMAPHORE_DB_DIALECT=sqlite
SEMAPHORE_DB_PATH=/etc/semaphore/semaphore.db
SEMAPHORE_PLAYBOOK_PATH=/tmp/semaphore/

SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@semaphore.lab
# Generate with: openssl rand -hex 16
SEMAPHORE_ADMIN_PASSWORD=change_me

# Key for encrypting stored access keys/secrets in the DB. Generate with: head -c32 /dev/urandom | base64
SEMAPHORE_ACCESS_KEY_ENCRYPTION=change_me

# Cookie signing/encryption keys for session security. Generate with: head -c32 /dev/urandom | base64
SEMAPHORE_COOKIE_HASH=change_me
SEMAPHORE_COOKIE_ENCRYPTION=change_me
