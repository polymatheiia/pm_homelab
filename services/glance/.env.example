# AdGuard Home credentials
# Used by the dns-stats widget on the Lab tab.
ADGUARD_USER=admin
ADGUARD_PASSWORD=change_me

# Nextcloud CalDAV credentials
# NEXTCLOUD_USER: your Nextcloud username
# NEXTCLOUD_PASSWORD: your Nextcloud password or an app password
#   (Settings → Security → Devices & sessions → Create new app password)
# Calendar slugs are hardcoded per subrequest in config/glance.yml (the last
# path segment before ?export — find it via Nextcloud → Calendar → ⋯ → Copy private link).
NEXTCLOUD_USER=your_nc_username
NEXTCLOUD_PASSWORD=change_me
