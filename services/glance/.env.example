# AdGuard Home credentials
# Used by the dns-stats widget on the Lab tab.
ADGUARD_USER=admin
ADGUARD_PASSWORD=change_me

# Calendar ICS feeds for the "Today" widget (Home tab)
# PROTON_CALENDAR_ICS_URL: Proton Calendar → Settings → Share with anyone →
#   Create link (paid plan required). Updates propagate on Proton's side
#   within up to 8 hours.
# USOS_ICAL_URL / MIM_CALENDAR_ICS_URL: any plain ICS feed URL works here —
#   USOS's per-user timetable link, a public Google Calendar .ics link, etc.
PROTON_CALENDAR_ICS_URL=https://calendar.proton.me/api/calendar/v1/url/.../calendar.ics?CacheKey=...&PassphraseKey=...
USOS_ICAL_URL=https://usosapps.example.edu/services/tt/upcoming_ical?lang=pl&user_id=0&key=change_me
MIM_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/example%40example.com/public/basic.ics
