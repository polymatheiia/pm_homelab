# Postgres backend
DB_DATA_LOCATION=/srv/pm_homelab/services/healthchecks/postgres-data
DB_NAME=hc
DB_USER=postgres
# Generate with: openssl rand -hex 24
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432

# App
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me
ALLOWED_HOSTS=*
SITE_ROOT=http://localhost:9013
SITE_NAME=Homelab Healthchecks
DEBUG=False
REGISTRATION_OPEN=False

# SMTP for email alerts — required for check-down notification emails.
# TODO: manual setup required — get SMTP creds from your mail provider
# (or a service like Mailgun/SES) and fill these in.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=healthchecks@example.org
