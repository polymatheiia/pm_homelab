# Libre Closet config. Full reference:
# https://github.com/lazztech/Libre-Closet#environment-variables
APP_NAME=Libre Closet
DATA_PATH=/app/data
AUTH_ENABLED=false
DISABLE_REGISTRATION=false
PWA_ENABLED=true
DATABASE_TYPE=sqlite
FILE_STORAGE_TYPE=local

# Generate with: openssl rand -base64 60
ACCESS_TOKEN_SECRET=change_me

# Generate with: npx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=change_me
PRIVATE_VAPID_KEY=change_me
