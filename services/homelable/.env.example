# Homelable — network topology visualizer, on-demand via Sablier (host port 9006, frontend only)
#
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me
#
# Note: the backend container has NET_RAW added (not full host networking) so it can run
# ping/traceroute/nmap-style scans. On this bridge network it cannot see LAN device MAC
# addresses (ARP doesn't cross the Docker bridge) — if you need MAC-based device tracking,
# switch the backend service to `network_mode: host` in docker-compose.yml instead of the
# `networks:`/`cap_add:` lines (Linux only; see upstream README).
