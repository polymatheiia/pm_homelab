# job-ops config. Full reference:
# https://github.com/DaKheera47/job-ops/blob/main/.env.example

# LLM provider used for CV tailoring/scoring. Examples: openrouter, openai,
# gemini, gemini_cli, claude_cli, codex. See upstream .env.example for the
# matching *_API_KEY / *_CLI_BIN variable for whichever you pick.
# TODO: manual setup required — pick a provider and set its credentials
MODEL=google/gemini-3-flash-preview
# LLM_PROVIDER=

# No auth by default (open on the .lab/Tailscale network only). Set both to
# enable Basic Auth if this ever needs to be reachable more broadly.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

JOBOPS_PUBLIC_BASE_URL=https://job-ops.lab

# Tailored-resume generation via the reactive-resume deployment in this repo.
# TODO: manual setup required — log into https://reactive-resume.lab, create
# an API key (Settings -> API Keys), and set it here.
RXRESUME_API_KEY=
RXRESUME_URL=https://reactive-resume.lab

# Gmail OAuth (tracking inbox) — optional.
# TODO: manual setup required — create an OAuth client in Google Cloud Console
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Job board sources — all optional, each unlocks one extra source.
# TODO: manual setup required if you want these
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# APIFY_TOKEN=
# UKVISAJOBS_EMAIL=
# UKVISAJOBS_PASSWORD=
