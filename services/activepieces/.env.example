# Activepieces — automation/workflow builder, on-demand via Sablier (host port 9009)

# 256-bit hex encryption key for stored secrets/connections. Generate with: openssl rand -hex 16
AP_ENCRYPTION_KEY=change_me

# JWT signing secret for API auth. Generate with: openssl rand -hex 32
AP_JWT_SECRET=change_me

AP_ENVIRONMENT=prod
AP_FRONTEND_URL=https://activepieces.lab
AP_EXECUTION_MODE=UNSANDBOXED

# Postgres
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=activepieces
# Generate with: openssl rand -hex 24
AP_POSTGRES_PASSWORD=change_me

# Redis (queueing)
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379

AP_TELEMETRY_ENABLED=false
