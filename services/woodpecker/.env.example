# Woodpecker CI — server + agent, on-demand via Sablier (host port 9011)
# Forge: GitHub (Woodpecker's default-documented OAuth provider).

WOODPECKER_HOST=https://woodpecker.lab
WOODPECKER_ADMIN=change_me_to_your_github_username

# TODO: manual setup required — register an OAuth app at github.com/settings/developers,
# callback URL https://woodpecker.lab/authorize. Fill in the client ID/secret it issues.
WOODPECKER_GITHUB_CLIENT=change_me
WOODPECKER_GITHUB_SECRET=change_me

# Shared secret between server and agent(s). Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=change_me
