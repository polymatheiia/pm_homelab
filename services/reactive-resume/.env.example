# Reactive Resume config. Full reference:
# https://github.com/reactive-resume/reactive-resume/blob/main/.env.example
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

PORT=3000
SERVER_PORT=3001
APP_URL=https://reactive-resume.lab

# Generate with: openssl rand -hex 32
AUTH_SECRET=change_me

# TODO: manual setup required — needs an SMTP account/relay to send
# verification/reset emails (skip to log console-only; see splitpro/healthchecks
# .env files in this repo for the shared Proton Bridge relay this homelab uses)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reactive Resume <noreply@grabovska.com>
SMTP_SECURE=false

# SeaweedFS (bundled S3-compatible storage — do not change unless you swap it
# out for a different backend).
S3_ACCESS_KEY_ID=seaweedfs
S3_SECRET_ACCESS_KEY=seaweedfs
S3_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=reactive-resume
S3_FORCE_PATH_STYLE=true

REDIS_URL=redis://redis:6379
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=change_me

FLAG_DISABLE_SIGNUPS=false
FLAG_DISABLE_EMAIL_AUTH=false
