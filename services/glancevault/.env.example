# GLANCEvault config. Full reference:
# https://github.com/glance-apps/glance-vault/blob/main/.env.example

# Single shared device token every GLANCE client presents.
# Generate with: openssl rand -hex 32
GLANCEVAULT_DEVICE_TOKEN=change_me

# Browser/desktop CORS origins allowed to call this server cross-origin.
# app://dayglance is dayGLANCE's Electron desktop renderer's fixed origin
# (required if you ever run the desktop build, harmless otherwise); the
# https://*.lab origins are this homelab's web builds of each GLANCE app.
GLANCEVAULT_ALLOWED_ORIGINS=app://dayglance,https://dayglance.lab,https://lifeglance.lab,https://lastglance.lab

# Auth model: "shared" (default) is correct for a single household/operator.
# GLANCEVAULT_AUTH_MODE=shared
